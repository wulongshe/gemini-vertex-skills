# Copy to .env at the root of the project where you use the skills.
# Skills search for the nearest .env: $CLAUDE_PROJECT_DIR, then the working
# directory upward, then the skills' install location upward. Values here take
# precedence over the system environment; keys left empty fall back to it.
GOOGLE_CLOUD_PROJECT=
# Region (e.g. us-central1) or "global" (uses the region-less endpoint).
GOOGLE_CLOUD_LOCATION=
# Path to the service-account JSON key; relative paths resolve against this
# file's directory, ~ is expanded.
GOOGLE_APPLICATION_CREDENTIALS=
# Bucket for --gcs uploads and Veo results (with or without the gs:// prefix).
GOOGLE_CLOUD_STORAGE=
